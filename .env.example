# Safe local-development placeholders only. Never put credentials in this file.
ZITADEL_ORIGIN=https://your-zitadel.example
ZITADEL_ORGANIZATION_ID=replace-with-organization-id
ZITADEL_ALLOWED_CLIENT_IDS=replace-with-client-id,replace-with-another-client-id
LOGIN_V2_FALLBACK_URL=https://your-zitadel.example/ui/v2/login
PAGES_ORIGIN=https://your-pages.example
SESSION_LIFETIME_SECONDS=900

# Set these only through encrypted Worker secrets in deployed environments.
ZITADEL_LOGIN_CLIENT_PAT=
# 32 random bytes encoded as unpadded base64url.
FLOW_COOKIE_KEY=
